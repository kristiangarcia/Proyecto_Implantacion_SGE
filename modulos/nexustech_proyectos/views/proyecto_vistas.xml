<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista formulario de Proyecto -->
    <record id="vista_formulario_proyecto" model="ir.ui.view">
        <field name="name">nexustech.proyecto.formulario</field>
        <field name="model">nexustech.proyecto</field>
        <field name="arch" type="xml">
            <form string="Proyecto IT">
                <header>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,en_progreso,finalizado"/>
                </header>
                <sheet>
                    <field name="imagen" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="nombre" placeholder="Nombre del proyecto..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Información General">
                            <field name="cliente_id"/>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                        <group string="Datos Económicos">
                            <field name="presupuesto"/>
                            <field name="horas_estimadas"/>
                            <field name="total_horas"/>
                            <field name="coste_total"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="descripcion" placeholder="Describe el proyecto..."/>
                        </page>
                        <page string="Tareas">
                            <field name="tarea_ids">
                                <list>
                                    <field name="nombre"/>
                                    <field name="responsable_id"/>
                                    <field name="prioridad"/>
                                    <field name="estado"/>
                                    <field name="fecha_limite"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista lista de Proyecto -->
    <record id="vista_lista_proyecto" model="ir.ui.view">
        <field name="name">nexustech.proyecto.lista</field>
        <field name="model">nexustech.proyecto</field>
        <field name="arch" type="xml">
            <list string="Proyectos IT">
                <field name="nombre"/>
                <field name="cliente_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="presupuesto"/>
                <field name="estado"/>
                <field name="coste_total"/>
            </list>
        </field>
    </record>

    <!-- Vista kanban de Proyecto -->
    <record id="vista_kanban_proyecto" model="ir.ui.view">
        <field name="name">nexustech.proyecto.kanban</field>
        <field name="model">nexustech.proyecto</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="estado">
                <field name="nombre"/>
                <field name="cliente_id"/>
                <field name="estado"/>
                <field name="presupuesto"/>
                <field name="imagen"/>
                <templates>
                    <t t-name="card">
                        <field name="imagen" widget="image" class="o_kanban_image"/>
                        <div class="oe_kanban_details">
                            <strong><field name="nombre"/></strong>
                            <div><field name="cliente_id"/></div>
                            <div>Presupuesto: <field name="presupuesto"/>€</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción de ventana para Proyectos -->
    <record id="accion_proyecto" model="ir.actions.act_window">
        <field name="name">Proyectos IT</field>
        <field name="res_model">nexustech.proyecto</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>
